{
	"name": "save-without-publish",
	"version": "0.1.0",
	"description": "Edit a published post as a private staged copy. The live post keeps serving until you publish the change.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"scripts": {
		"build": "wp-scripts build",
		"start": "wp-scripts start",
		"lint:js": "wp-scripts lint-js src tests/e2e",
		"env:start": "wp-env start",
		"env:stop": "wp-env stop",
		"test:php": "wp-env run tests-cli --env-cwd=wp-content/plugins/save-without-publish composer test",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test": "npm run test:php && npm run test:e2e"
	},
	"devDependencies": {
		"@playwright/test": "^1.62.1",
		"@wordpress/api-fetch": "^7.53.0",
		"@wordpress/block-editor": "^16.2.0",
		"@wordpress/components": "^39.0.0",
		"@wordpress/data": "^10.53.0",
		"@wordpress/e2e-test-utils-playwright": "^1.53.0",
		"@wordpress/editor": "^14.53.0",
		"@wordpress/element": "^8.5.0",
		"@wordpress/env": "^10.0.0",
		"@wordpress/escape-html": "^3.53.0",
		"@wordpress/hooks": "^4.53.0",
		"@wordpress/i18n": "^6.26.0",
		"@wordpress/notices": "^5.53.0",
		"@wordpress/plugins": "^7.53.0",
		"@wordpress/primitives": "^4.53.0",
		"@wordpress/scripts": "^34.0.0",
		"@wordpress/url": "^4.53.0",
		"typescript": "^5.9.0"
	}
}
